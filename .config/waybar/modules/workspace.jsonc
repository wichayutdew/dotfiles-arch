      // --- Graphics & Visual ---
      "xdg-desktop-portal-gtk": "",
      "nemo": "",
      "yazi": "󰇥",
      "satty": "󰄄",
      "mpv": "󰕼",
      // --- System ---
      "blueman-manager": "",
      "pavucontrol": "󱕂",
      "nmgui": "󰐻",
      // --- Tool ---
      "nwg-look": "󰒓",
      "qt5ct": "󰒓",
      "qt6ct": "󰒓",
      "designer": "󰒓",
      "linguist": "󰒓",
      "assistant": "󰒓",
