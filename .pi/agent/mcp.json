{
  "mcpServers": {
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      },
      "directTools": [
        "resolve-library-id",
        "query-docs"
      ]
    },
    "gh_grep": {
      "url": "https://mcp.grep.app",
      "auth": false,
      "directTools": [
        "searchGitHub"
      ]
    },
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "auth": "bearer",
      "bearerToken": "!/opt/homebrew/bin/gh auth token",
      "protocolVersion": "auto"
    }
  }
}
