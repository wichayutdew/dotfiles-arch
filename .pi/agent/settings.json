{
  "lastChangelogVersion": "1.1.0",
  "defaultProvider": "openrouter",
  "defaultModel": "thinkingmachines/inkling:free",
  "defaultThinkingLevel": "medium",
  "shellPath": "/usr/sbin/fish",
  "packages": [
    "npm:@plannotator/pi-extension",
    "npm:pi-web-access"
  ],
  "terminal": {
    "showTerminalProgress": true,
    "clearOnShrink": true,
    "imageWidthCells": 60
  },
  "doubleEscapeAction": "tree",
  "treeFilterMode": "all",
  "compaction": {
    "enabled": true,
    "reserveTokens": 32768,
    "keepRecentTokens": 24000
  },
  "enableSkillCommands": true,
  "editorPaddingX": 2,
  "autocompleteMaxVisible": 3,
  "transport": "auto",
  "quietStartup": false,
  "outputPad": 1,
  "theme": "system",
  "fullscreenExitOutput": "transcript",
  "fullscreenScrollbar": "auto",
  "extensions": [],
  "showHardwareCursor": false,
  "markdown": {
    "mermaid": "streaming"
  },
  "warnings": {
    "anthropicExtraUsage": true
  },
  "tuiMode": "fullscreen",
  "fullscreenWheelScrollLines": "auto"
}