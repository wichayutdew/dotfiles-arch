{
  "lastChangelogVersion": "0.86.1",
  "defaultProvider": "openrouter",
  "defaultModel": "thinkingmachines/inkling:free",
  "defaultThinkingLevel": "medium",
  "shellPath": "/usr/sbin/fish",
  "packages": [
    "npm:pi-zentui",
    "npm:@plannotator/pi-extension",
    "npm:pi-mcp-adapter",
    "npm:pi-web-access"
  ],
  "terminal": {
    "showTerminalProgress": true,
    "clearOnShrink": true,
    "imageWidthCells": 60
  },
  "doubleEscapeAction": "tree",
  "treeFilterMode": "all",
  "compaction": {
    "enabled": true,
    "reserveTokens": 32768,
    "keepRecentTokens": 24000
  },
  "enableSkillCommands": false,
  "editorPaddingX": 2,
  "autocompleteMaxVisible": 3,
  "transport": "auto",
  "quietStartup": false,
  "outputPad": 1,
  "theme": "light/dark"
}
