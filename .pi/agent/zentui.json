{
  "colorSources": {
    "starship": "theme",
    "editor": "theme",
    "userMessages": "theme"
  },
  "features": {
    "copyFriendly": true,
    "editor": true,
    "statusLine": true
  },
  "fixedEditor": {
    "enabled": true,
    "copyNotice": true,
    "mouseScroll": true
  },
  "contextStyle": "text+gauge",
  "separator": "chevron",
  "pathDisplay": {
    "mode": "full",
    "depth": 5
  },
  "gitBranch": {
    "maxLength": "full"
  },
  "icons": {
    "mode": "nerd"
  },
  "footerSegments": {
    "gitCounts": true,
    "sessionDuration": true,
    "username": false,
    "time": false,
    "cwd": true,
    "gitBranch": true,
    "os": true,
    "runtime": true,
    "context": true,
    "tokens": true,
    "cost": true,
    "packageVersion": true,
    "gitCommit": true,
    "gitMetrics": true,
    "gitStatus": true
  },
  "extensionStatuses": {
    "placements": {
      "mcp": "middle",
      "plannotator": "middle"
    },
    "colorModes": {
      "mcp": "zentui",
      "plannotator": "zentui"
    }
  },
  "gitMetrics": {
    "ignoreSubmodules": false
  },
  "components": {
    "editor": {
      "enabled": true,
      "style": "opencode-copy-friendly",
      "colorSource": "theme",
      "borderColorMode": "adaptive",
      "modelLabel": "id",
      "viewportIndicators": true,
      "styles": {
        "opencode": {
          "metadataFormat": "$model  $provider(  $thinking)"
        },
        "opencode-copy-friendly": {
          "metadataFormat": "$model  $provider(  $thinking)"
        },
        "minimalist": {
          "pathDisplay": "compact",
          "contextFormat": "percent",
          "contextGauge": false,
          "showSessionName": true,
          "showTimer": true,
          "showCost": true,
          "showGit": true,
          "contextThresholds": {
            "warning": 70,
            "error": 90
          }
        }
      }
    },
    "userMessages": {
      "enabled": true,
      "style": "labeled",
      "colorSource": "terminal",
      "styles": {
        "framed": {},
        "framed-copy-friendly": {},
        "compact": {},
        "labeled": {}
      }
    },
    "workingLine": {
      "enabled": true,
      "turnSummary": true,
      "spinner": "pulse",
      "spinnerIntervalMs": 160,
      "animateSpinnerColor": true,
      "textIntervalMs": 40,
      "textAnimation": "disabled",
      "colorSource": "terminal",
      "messages": {
        "custom": true,
        "values": [
          "Sautéing…",
          "Cooking…",
          "Ionizing…",
          "Zigzagging…",
          "Razzle-dazzling…",
          "Photosynthesizing…",
          "Nucleating…",
          "Brewing…",
          "Combobulating…",
          "Boogieing…",
          "Befuddling…",
          "Alchemizing…",
          "Conjuring…",
          "Baking…",
          "Simmering…",
          "Blanching…"
        ]
      },
      "segments": {
        "tool": true,
        "elapsed": true,
        "thought": true,
        "tokens": true
      }
    },
    "selectorBorders": {
      "enabled": true,
      "style": "zentui",
      "colorSource": "terminal"
    },
    "footer": {
      "style": "starship",
      "colorSource": "terminal",
      "modelLabel": "id",
      "styles": {
        "starship": {
          "format": "",
          "responsive": true,
          "compactFormat": "$cwd$wrap(in $session_name)$wrap(on $git_branch) $git_status$wrap$context$wrap_sep$tokens",
          "compactMaxLines": 2,
          "separator": "chevron",
          "contextStyle": "text+gauge",
          "contextThresholds": {
            "warning": 70,
            "error": 90
          },
          "pathDisplay": {
            "mode": "full",
            "depth": 5
          },
          "segments": {
            "cwd": true,
            "sessionName": true,
            "gitBranch": true,
            "gitStatus": false,
            "gitCounts": true,
            "gitCommit": true,
            "gitMetrics": true,
            "runtime": true,
            "modelInfo": false,
            "context": true,
            "tokens": false,
            "cost": true,
            "sessionDuration": true,
            "username": false,
            "time": false,
            "os": true,
            "packageVersion": true
          },
          "gitBranch": {
            "maxLength": "full"
          },
          "gitCommit": {
            "hashLength": 7,
            "onlyDetached": true,
            "showTag": true
          },
          "gitMetrics": {
            "onlyNonzero": true,
            "ignoreSubmodules": false
          },
          "extensionStatuses": {
            "defaultPlacement": "right",
            "placements": {
              "mcp": "middle",
              "plannotator": "middle"
            },
            "colorModes": {
              "mcp": "original",
              "plannotator": "zentui"
            }
          }
        }
      }
    }
  }
}
